"use strict";

let identityProxy = bridge.getIdentityServiceProxy();
let friendProxy = bridge.getFriendServiceProxy();
let scriptProxy = bridge.getScriptServiceProxy();

let PRE_REGISTRATION_ENABLED = true;
let PRE_REGISTRATION_AUTH_TYPE = "Email";

let EXTERNAL_AUTH_TYPE = "oauth2-sso";

let ISSUER = "<issuer>";
let CLIENT_ID = "<client_id>";
let SUB_CLAIM = "email";

function findUser(externalId) {
  let lookupResult = friendProxy.getProfileInfoForExternalAuthIdIfExists(externalId, EXTERNAL_AUTH_TYPE);

  if (lookupResult.status === 200) {
    return lookupResult.data?.profileId || null;
  }

  return null;
}

function findPreRegisteredUser(externalId) {
  let lookupResult = friendProxy.getProfileInfoForCredentialIfExists(externalId, PRE_REGISTRATION_AUTH_TYPE);

  if (lookupResult.status === 200) {
    return lookupResult.data?.profileId || null;
  }

  return null;
}

function main() {
  bridge.logInfo("Attempting to authenticate user: " + data.externalId);

  let authenticationToken = data.authenticationToken;

  let runningInAttachIdentityContext = false;

  if (authenticationToken.startsWith("PRE-REGISTERED:")) {
    authenticationToken = authenticationToken.substring("PRE-REGISTERED:".length);

    runningInAttachIdentityContext = true;
  }

  let oauth2Resp = identityProxy.verifyOktaJwt(ISSUER, CLIENT_ID, authenticationToken);

  if (oauth2Resp.status !== 200) {
    bridge.logErrorJson("Token not valid: " + authenticationToken, oauth2Resp);
    
    return false;
  }

  let claims = oauth2Resp.data?.claims || null;

  if (claims == null || Object.keys(claims).length === 0) {
    bridge.logErrorJson("No claim's found", oauth2Resp);

    return false;
  }

  let iss = claims['iss'];

  if (iss !== ISSUER) {
    bridge.logError("Token has incorrect issuer: " + iss);

    return false;
  }

  let sub = claims[SUB_CLAIM];

  if (sub == null || sub.length === 0) {
    sub = claims["sub"]; // If no SUB_CLAIM claim is found, fallback to using the standard 'sub' claim.

    if (sub == null || sub.length === 0) {
      bridge.logErrorJson("No valid sub's found using claim: " + SUB_CLAIM, claims);

      return false;
    }
  }

  let externalId = sub;

  if (externalId !== data.externalId) {
    bridge.logError("The identified sub '" + externalId + "' does not match the external id '" + data.externalId + "'");

    return false;
  }

  let profileId = findUser(externalId);

  let preRegisteredProfileId = null;

  if (!runningInAttachIdentityContext) {
    if (profileId == null && PRE_REGISTRATION_ENABLED) {
      bridge.logInfo("Checking for pre-registration ("+ PRE_REGISTRATION_AUTH_TYPE +"): " + externalId);

      preRegisteredProfileId = findPreRegisteredUser(externalId);

      if (preRegisteredProfileId != null) {
        bridge.logInfo("Found pre-registration ("+ PRE_REGISTRATION_AUTH_TYPE +"): " + externalId + " (" + preRegisteredProfileId + ")");
      } else {
        bridge.logInfo("No pre-registration found ("+ PRE_REGISTRATION_AUTH_TYPE +"): " + externalId);
      }
    }

    if (preRegisteredProfileId != null) {
      let attachIdentityResp = scriptProxy.runScript("attach_external_identity", {
        profileId: preRegisteredProfileId,
        externalId: externalId,
        authenticationToken: authenticationToken,
        externalAuthName: EXTERNAL_AUTH_TYPE
      });

      if (attachIdentityResp.status !== 200 || !attachIdentityResp.data.success) {
        bridge.logWarningJson("Could not attach external identity", attachIdentityResp);

        preRegisteredProfileId = null;
      }
    }
  }

  let response = {
    valid: true,
    profileId: profileId,
    useProfileId: preRegisteredProfileId,
  };

  bridge.logInfo("Successfully authenticated user (" + externalId + "): " + (preRegisteredProfileId || profileId));

  return response;
}

main();

