# Environment variablkes usd by create-react-app when running a local dev server.
PORT=3001
HTTPS=true
FAST_REFRESH=false
NODE_TLS_REJECT_UNAUTHORIZED=0

# Environment variables for the API server.
REACT_APP_BC_API_TARGET_HOST=<api_server_host>
REACT_APP_BC_API_TARGET_PORT=443

# Environment variables for the brainCloud APP.
REACT_APP_BC_APP_ID=<app_id>
REACT_APP_BC_APP_SECRET=<app_secret>
REACT_APP_BC_APP_VERSION=<app_version>

# Environment variables for the configured external auth type and SAML integration (for the above brainCloud APP).
REACT_APP_BC_EXTERNAL_AUTH_NAME=<external_auth_name>
REACT_APP_BC_PAGE_NAME=<page_name>

# Environment variables for the SAML provider.
REACT_APP_SSO_ISSUER=<issuer>
REACT_APP_SSO_AUTHORIZATION_ENDPOINT=<authorization_endpoint>
REACT_APP_SSO_END_SESSION_ENDPOINT=<end_session_endpoint

# Environment variables for the WebHook test.
REACT_APP_WEBHOOK_NAME=<webhook_name>
REACT_APP_WEBHOOK_SECRET=<webhook_secret>